# Copy to .env next to docker-compose.yml. DB_PASSWORD, APP_URL and UPDATER_SECRET are required.
# APP_KEY is generated on first start and kept in the storage volume (storage/app.key); see APP_KEY below to override.

DB_PASSWORD=
APP_URL=http://127.0.0.1:8080

# Required: shared secret of app and updater container (update by click), at least 32 characters:
#   openssl rand -hex 32
UPDATER_SECRET=

# Strongly recommended: set a random value (e.g. `openssl rand -hex 24`).
# /install then requires it; left empty, the installer is first-come, first-served.
IGNIS_INSTALL_TOKEN=

# Optional
# Session cookie with the Secure flag (default true; needs HTTPS at the proxy). Set false only for a plain-http test setup.
# SESSION_SECURE_COOKIE=true
# Root password of the database. Empty: random, kept only in the db volume (/var/lib/mysql/.root-password), never in the log.
# Takes effect on a fresh db volume only.
# DB_ROOT_PASSWORD=
# APP_PORT=8080
# Trusted reverse proxies (comma-separated IPs, or *). Default * is safe because the app port is loopback-only.
# TRUSTED_PROXIES=*
# Overrides storage/app.key (e.g. to restore a backed-up key). Must be a Laravel key: base64:...
# APP_KEY=
# Release version of a local build (written into the image as VERSION). dev = no update by click.
# IGNIS_VERSION=dev
# GitHub repository (owner/name) of the signed releases; empty = update check and update by click locked.
# IGNIS_RELEASE_REPO=

# One-off import from the old intraRP database (docs/dev/import.md). Use a SELECT-only DB user,
# and remove the password again after the cutover (then `docker compose up -d`).
# LEGACY_DB_HOST=
# LEGACY_DB_PORT=3306
# LEGACY_DB_DATABASE=legacy
# LEGACY_DB_USERNAME=
# LEGACY_DB_PASSWORD=
# IGNIS_IMPORT_LEGACY_TIMEZONE=Europe/Berlin
# Organisation time zone ("today", all-day dates, calendar feeds). Default Europe/Berlin.
# IGNIS_TIMEZONE=Europe/Berlin
# Realtime (optional, INSTALL.md "Echtzeit"): both lines together. REVERB_APP_ID/KEY/SECRET are generated into the
# storage volume when empty; set them here only to pin them.
# BROADCAST_CONNECTION=reverb
# COMPOSE_PROFILES=reverb
# Image to run (and pull on update). Default: the locally built ignis:local.
# IMAGE_TAG=ignis:local
