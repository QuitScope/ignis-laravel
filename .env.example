APP_NAME=Ignis
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Comma-separated proxy IPs, or * when behind a reverse proxy you control
# TRUSTED_PROXIES=

# Strongly recommended on public servers: /install and ignis:install then require this token.
IGNIS_INSTALL_TOKEN=

# Organisation time zone ("today", all-day dates, calendar feeds); storage stays UTC. Invalid values fall back to Europe/Berlin.
# IGNIS_TIMEZONE=Europe/Berlin

# Timezone of the legacy dates for ignis:import-legacy (legacy PHP date.timezone; set UTC if the legacy server runs in UTC).
# IGNIS_IMPORT_LEGACY_TIMEZONE=Europe/Berlin

# Federation module (off by default): peers must be https with a public address. Comma list = only these hosts;
# FEDERATION_ALLOW_PRIVATE=true allows private/LAN addresses (never http or redirects).
FEDERATION_ALLOWED_HOSTS=
FEDERATION_ALLOW_PRIVATE=false

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ignis
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Behind HTTPS set true (the Docker stack defaults to true; see INSTALL.md).
# SESSION_SECURE_COOKIE=true

# Realtime (optional, INSTALL.md "Echtzeit"): null = off, pages poll. reverb = pulses over `php artisan reverb:start`.
BROADCAST_CONNECTION=null
# With reverb: three random values (openssl rand -hex 16); the server address is internal, browsers use APP_URL/app.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8081
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
